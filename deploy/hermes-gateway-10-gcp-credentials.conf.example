# Fetches the hermes-memory-agent SA key from GCP Secret Manager into
# tmpfs at startup, so GOOGLE_APPLICATION_CREDENTIALS never points at
# a persistent on-disk key file. See hermes-memory-layer/scripts/fetch-sa-key.sh.
#
# Deployed as a systemd drop-in (not a base-unit edit) because hermes_cli's
# refresh_systemd_unit_if_needed() self-heals the base unit back to its
# generated template and would silently discard direct edits.
[Service]
ExecStartPre=/home/tojotheterror/hermes-memory-layer/scripts/fetch-sa-key.sh
Environment="GOOGLE_APPLICATION_CREDENTIALS=/dev/shm/hermes-gcp-keys/hermes-memory-agent.json"
